# ─────────────────────────────────────────────────────────────
# ENMAR ECO-COMMERCE - ENVIRONMENT CONFIGURATION TEMPLATE
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and configure your MySQL database credentials.

# Server Port
PORT=3000

# MySQL Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=enmar_db

# Session Security Secret
SESSION_SECRET=your_random_secure_session_secret
