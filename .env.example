# ==============================================================================
# ENMAR Production Environment Configuration Template
# Copy this file to `.env` on your server and configure your secret values.
# ==============================================================================

# ── Server & Runtime ──
PORT=3000
NODE_ENV=production

# ── Superadmin Account Credentials ──
# Required in production. Minimum 8 characters. Choose a strong, unique password.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=your_superadmin_password

# ── SMS Gateway Configuration (Alpha SMS / SMS.NET.BD) ──
# Used for phone verification (OTP) and customer notifications.
SMS_PROVIDER=alpha
SMS_BASE_URL=https://api.sms.net.bd/sendsms
SMS_API_KEY=your_alpha_sms_api_key_here
SMS_SENDER_ID=

# ── SMTP Email Gateway (Gmail / Custom SMTP) ──
# For 6-digit email OTPs, password resets, and order receipts.
# If using Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=ENMAR

# ── MySQL Relational Database Configuration (REQUIRED for production) ──
# The application requires a MySQL database to store all orders, users, products, and settings.
# Without these credentials, the app will fail to start or operate correctly.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_mysql_password
DB_NAME=enmar_db

